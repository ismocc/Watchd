# used by docker compose

# free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# any long random string
JWT_SECRET=

# people need this to sign up. leave empty to let anyone sign up
INVITE_CODE=

# password for the database (letters and numbers only)
POSTGRES_PASSWORD=watchd

# port the app runs on
PORT=3000
